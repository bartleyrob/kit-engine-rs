{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KitStation",
  "version":     "0.1.0",
  "identifier":  "uk.rob.kitstation",
  "build": {
    "frontendDist": "../web",
    "devUrl":       null,
    "beforeDevCommand":   null,
    "beforeBuildCommand": null
  },
  "app": {
    "windows": [
      {
        "title":  "KitStation",
        "width":  1560,
        "height": 940,
        "resizable":   true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active":     true,
    "targets":    "all",
    "icon":       ["icons/icon.ico", "icons/icon.icns", "icons/icon.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "category":   "Music",
    "shortDescription": "Native drum-machine / sampler with WebView UI.",
    "longDescription":  "KitStation is a cross-platform sampler + sequencer built on the kit-engine core (sample player, per-pad polyphony, master FX, MIDI I/O) with an HTML UI."
  }
}
